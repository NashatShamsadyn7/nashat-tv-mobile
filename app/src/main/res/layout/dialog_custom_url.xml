<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/m3u_url_prompt"
        android:textColor="@color/home_text_secondary"
        android:textSize="@dimen/type_size_body_medium"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://example.com/playlist.m3u"
        style="@style/Widget.Nashat.TextInput">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCustomUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="@color/white"
            android:textColorHint="@color/home_text_tertiary" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  A titled horizontal row. The heading carries a short accent tick and an
  optional trailing action ("See all" or a count); rows are separated by space
  rather than rules, so the artwork does the dividing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_600">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_300">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_accent_tick" />

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_200"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Nashat.Section" />

        <TextView
            android:id="@+id/rowAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_press_soft"
            android:paddingHorizontal="@dimen/space_200"
            android:paddingVertical="@dimen/space_100"
            android:textAppearance="@style/TextAppearance.Nashat.Label.Medium"
            android:textColor="@color/accent_text"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:scrollbars="none" />

    <ProgressBar
        android:id="@+id/rowLoading"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="@dimen/space_800"
        android:indeterminateTint="@color/accent_text" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/focus_scale"
    android:background="@drawable/selector_glass_card"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeWidth="@dimen/edge_width"
    app:strokeColor="@color/edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/imgEpisodeImage"
            android:layout_width="120dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:background="?android:attr/colorBackground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtEpisodeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Pilot"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/type_size_body_large"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtEpisodeOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Overview of the episode..."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_size_label_medium"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imgWatched"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_success"
            android:visibility="gone" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_play"
            app:tint="@color/accent_primary" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

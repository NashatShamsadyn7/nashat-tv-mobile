<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/focus_scale"
    app:cardUseCompatPadding="false"
    app:cardCornerRadius="18dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/transparent"
    app:cardBackgroundColor="@color/transparent"
    app:cardElevation="0dp"
    android:background="@drawable/selector_glass_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <!-- Logo Circle -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="@dimen/channel_logo_size"
            android:layout_height="@dimen/channel_logo_size"
            android:background="@drawable/logo_background_dark">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_channel_logo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:padding="8dp" />

            <TextView
                android:id="@+id/txtLogoFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/accent_primary"
                android:visibility="gone"
                android:background="@drawable/fallback_logo_background" />
        </FrameLayout>

        <!-- Channel Name -->
        <TextView
            android:id="@+id/txtChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Channel"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp" />

        <!-- Live indicator -->
        <TextView
            android:id="@+id/txtLiveTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="● LIVE"
            android:textSize="9sp"
            android:textColor="@color/accent_emerald"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

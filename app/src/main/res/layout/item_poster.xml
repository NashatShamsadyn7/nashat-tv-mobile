<?xml version="1.0" encoding="utf-8"?>
<!--
    One title in a row or grid.

    Fixed width, not wrap_content: a row of posters whose widths follow their
    titles has a ragged rhythm and no longer scans as a grid. The poster's 2:3
    ratio is enforced by the image height so a missing or oddly-shaped artwork
    cannot change the card's size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/poster_width"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_200">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/poster_height">

        <!--
            The 2dp frame is the change that makes a row of TMDB artwork look
            like one designed screen rather than a folder of images. Posters
            arrive with wildly different edges — some are full-bleed, some
            have their own white border baked in, some fade to black — and
            without a frame the row has no consistent left edge to scan down.
        -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_sunken"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Nashat.Square"
            app:strokeColor="@color/edge"
            app:strokeWidth="@dimen/edge_width" />

        <!-- Rating chip. Hidden entirely when TMDB has no score, rather than
             showing a meaningless 0.0. -->
        <LinearLayout
            android:id="@+id/ratingChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_150"
            android:background="@drawable/bg_rating_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_150"
            android:paddingVertical="@dimen/space_50">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star_24"
                app:tint="@color/rating_star" />

            <TextView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_50"
                android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                android:textColor="@color/white" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_150"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2"
        android:textAppearance="@style/TextAppearance.Nashat.Label.Large"
        android:textColor="@color/content_primary" />

    <TextView
        android:id="@+id/year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
        android:textColor="@color/content_tertiary" />

</LinearLayout>

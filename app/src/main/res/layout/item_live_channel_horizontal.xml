<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel card.

  Everything shown here is bound from the Channel in LiveTvAdapter. The previous
  version carried three views the adapter never touched — a category line, a
  corner badge and a latency read-out — so every card in the app permanently
  displayed the literal strings "Category", "Sports" and "190 ms • 430 ms open".
  The latency read-out is gone entirely: stream timings are diagnostics, not
  something to put in front of someone choosing what to watch.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="168dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_none"
    app:cardElevation="0dp"
    app:strokeColor="@color/edge"
    app:strokeWidth="@dimen/edge_width">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/logoFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/bg_secondary"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Kept for the adapter's per-category tint. There is no overlay
                 on top of the logo any more; the old one sat at 0.55 alpha and
                 washed out every broadcaster's mark. -->
            <View
                android:id="@+id/cardGradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/ivChannelLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_channel_logo"
                android:padding="16dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/liveIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/live_badge_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <View
                    android:id="@+id/liveDot"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/live_dot" />

                <TextView
                    android:id="@+id/tvLiveText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/live"
                    android:textColor="@color/accent_primary_light"
                    android:textSize="@dimen/type_size_label_small"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/logoFrame">

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/type_size_body_medium"
                android:textStyle="bold"
                tools:text="Rûdaw TV" />

            <TextView
                android:id="@+id/tvChannelCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_size_label_medium"
                tools:text="News" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

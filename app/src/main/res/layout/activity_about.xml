<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/about_bg_dark"
    android:fitsSystemWindows="true"
    tools:context=".AboutActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:elevation="0dp"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/about_toolbar_bg"
            app:title="@string/about_title"
            app:titleTextColor="@color/accent_primary"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="@color/accent_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- App Logo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="8dp"
                app:strokeWidth="@dimen/edge_width"
                app:strokeColor="@color/accent_primary"
                app:cardBackgroundColor="@color/about_card_bg"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/nashat_logo"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- App Name -->
            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textStyle="bold"
                android:textColor="@color/accent_primary"
                android:layout_gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- App Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/about_text_secondary"
                android:layout_gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Version -->
            <TextView
                android:id="@+id/appVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0.0"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/about_text_tertiary"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Developer Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="4dp"
                app:strokeWidth="@dimen/edge_width"
                app:strokeColor="@color/edge"
                app:cardBackgroundColor="@color/about_card_bg"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/nashat_profile"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        android:layout_marginBottom="12dp"
                        app:strokeWidth="@dimen/edge_width"
                        app:strokeColor="@color/accent_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/created_by"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/about_text_tertiary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/developer_name"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@color/accent_primary" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/developer"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/about_text_tertiary"
                        android:layout_marginBottom="16dp" />

                    <!-- Social Icons Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        
                        <!-- WhatsApp -->
                        <FrameLayout
                            android:id="@+id/btnWhatsapp"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_whatsapp_real" />
                        </FrameLayout>

                        <!-- Telegram -->
                        <FrameLayout
                            android:id="@+id/btnTelegram"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_telegram_real" />
                        </FrameLayout>

                        <!-- Facebook -->
                        <FrameLayout
                            android:id="@+id/btnFacebook"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_facebook_real" />
                        </FrameLayout>

                        <!-- Instagram -->
                        <FrameLayout
                            android:id="@+id/btnInstagram"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_instagram_real" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About Description Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="4dp"
                app:strokeWidth="@dimen/edge_width"
                app:strokeColor="@color/edge"
                app:cardBackgroundColor="@color/about_card_bg"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_title"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/accent_success"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/aboutBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_body"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/about_text_secondary"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rate App Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRateApp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/rate_app"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_success"
                app:icon="@drawable/ic_rate_24"
                app:iconTint="@color/accent_primary"
                app:cornerRadius="@dimen/radius_md"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Details for one film or series.

  The backdrop fades into the page and the poster card overlaps it. Under the
  actions sits "By the numbers": the audience score as a large ring, a grid of
  key figures, and a chart that fits the title — runtime against a 3-hour
  film, budget against box office, or episodes per season. Then synopsis,
  episodes, cast and recommendations.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_1200">

            <!-- ═══ Backdrop ═══ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/details_backdrop_height">

                <ImageView
                    android:id="@+id/backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_backdrop_fade" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/space_300"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_round_scrim"
                    android:contentDescription="@string/cd_back_button"
                    android:src="@drawable/ic_arrow_back_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- ═══ Poster + title ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-96dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_gutter">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/poster"
                    android:layout_width="@dimen/details_poster_width"
                    android:layout_height="@dimen/details_poster_height"
                    android:background="@color/surface_sunken"
                    android:elevation="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/ShapeAppearance.Nashat.Square"
                    app:strokeColor="@color/edge"
                    app:strokeWidth="@dimen/edge_width" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_400"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/kindBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Nashat.Eyebrow" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_50"
                        android:textAppearance="@style/TextAppearance.Nashat.HeroTitle"
                        android:textColor="@color/content_primary"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_100"
                        android:textAppearance="@style/TextAppearance.Nashat.Body.Small"
                        android:textColor="@color/content_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Genre pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_400"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/genres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- ═══ Actions ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_400"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_gutter">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/action_play"
                    app:icon="@drawable/ic_play_arrow_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrailer"
                    style="@style/Widget.Nashat.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_200"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/action_trailer"
                    android:visibility="gone"
                    app:icon="@drawable/ic_movie_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_200"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_gutter">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWatchlist"
                    style="@style/Widget.Nashat.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/action_add_watchlist"
                    android:text="@string/action_my_list"
                    app:icon="@drawable/ic_playlist_add" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavorite"
                    style="@style/Widget.Nashat.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_200"
                    android:layout_weight="1"
                    android:contentDescription="@string/action_add_favorite"
                    android:text="@string/row_favorites"
                    app:icon="@drawable/ic_favorite_24" />
            </LinearLayout>

            <!-- ═══ Synopsis ═══ -->
            <TextView
                android:id="@+id/tagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_600"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:textAppearance="@style/TextAppearance.Nashat.Title.Medium"
                android:textColor="@color/content_primary"
                android:textStyle="italic"
                android:visibility="gone" />

            <TextView
                android:id="@+id/overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_200"
                android:lineSpacingMultiplier="1.15"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:textAppearance="@style/TextAppearance.Nashat.Body.Medium"
                android:textColor="@color/content_secondary" />

            <!-- ═══ By the numbers ═══ -->
            <LinearLayout
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_600"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="@dimen/space_500">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/details_by_numbers"
                    android:textAppearance="@style/TextAppearance.Nashat.Eyebrow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_300"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.nashat.tv.ui.chart.RatingRing
                        android:id="@+id/scoreRing"
                        android:layout_width="76dp"
                        android:layout_height="76dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_400"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/details_audience"
                            android:textAppearance="@style/TextAppearance.Nashat.Title.Small"
                            android:textColor="@color/content_primary" />

                        <TextView
                            android:id="@+id/scoreVotes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Nashat.Body.Small"
                            android:textColor="@color/content_secondary" />

                        <!-- Score as a ten-step bar: easier to compare at a glance than a decimal. -->
                        <com.nashat.tv.ui.chart.StepBar
                            android:id="@+id/scoreSteps"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="@dimen/space_200" />
                    </LinearLayout>
                </LinearLayout>

                <GridLayout
                    android:id="@+id/statGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_500"
                    android:columnCount="3" />

                <!-- Runtime, money or seasons: filled per title. -->
                <LinearLayout
                    android:id="@+id/statCharts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ═══ Episodes ═══ -->
            <LinearLayout
                android:id="@+id/episodesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_800"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/screen_gutter">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_accent_tick" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_200"
                        android:layout_weight="1"
                        android:text="@string/details_episodes"
                        android:textAppearance="@style/TextAppearance.Nashat.Section" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeason"
                        style="@style/Widget.Nashat.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_list_24" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/episodesLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="@dimen/space_600"
                    android:indeterminateTint="@color/accent_text" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_300"
                    android:paddingHorizontal="@dimen/screen_gutter" />
            </LinearLayout>

            <!-- ═══ Cast ═══ -->
            <LinearLayout
                android:id="@+id/castSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_800"
                android:orientation="vertical">

                <include layout="@layout/view_section_title"
                    android:id="@+id/castTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/castList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/screen_gutter"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ═══ More like this ═══ -->
            <LinearLayout
                android:id="@+id/recommendationsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_800"
                android:orientation="vertical">

                <include layout="@layout/view_section_title"
                    android:id="@+id/recsTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommendationsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/screen_gutter"
                    android:scrollbars="none" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/detailsLoading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_text" />

    <LinearLayout
        android:id="@+id/detailsError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_800"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/details_load_failed_title"
            android:textAppearance="@style/TextAppearance.Nashat.Title.Medium"
            android:textColor="@color/content_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_200"
            android:gravity="center"
            android:text="@string/details_load_failed_body"
            android:textAppearance="@style/TextAppearance.Nashat.Body.Medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_600"
            android:text="@string/action_retry" />
    </LinearLayout>

</FrameLayout>

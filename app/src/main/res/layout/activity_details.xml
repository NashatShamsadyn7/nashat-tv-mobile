<?xml version="1.0" encoding="utf-8"?>
<!--
    Title details — one layout for films and series, ported from the desktop
    client's pages/Details.tsx.

    The desktop lays the poster and metadata *over* the backdrop, which works at
    1400px wide. On a phone that same composition leaves the synopsis sitting on
    a busy photograph at four words a line. Here the backdrop is a 16:9 header
    and the text sits below it on a real surface — the same information in the
    same order, re-laid for the width it actually has.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_800">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══ Hero ═══ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/details_backdrop_height"
                    android:background="@color/surface_sunken"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <!-- Fades the backdrop into the page so the join is not a hard
                     horizontal line across the screen. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_details_fade" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_200"
                    android:background="@drawable/bg_scrim_circle"
                    android:contentDescription="@string/cd_back_button"
                    android:src="@drawable/ic_arrow_back_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- ═══ Poster + headline ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_gutter">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/poster"
                    android:layout_width="96dp"
                    android:layout_height="144dp"
                    android:background="@color/surface_sunken"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/ShapeAppearance.Nashat.Medium"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_300"
                    android:layout_marginTop="48dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Nashat.Title.Large"
                        android:textColor="@color/content_primary" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_100"
                        android:textAppearance="@style/TextAppearance.Nashat.Label.Medium"
                        android:textColor="@color/content_secondary" />

                    <TextView
                        android:id="@+id/genres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_100"
                        android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                        android:textColor="@color/content_tertiary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Actions ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_400"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_gutter">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/action_play"
                    app:icon="@drawable/ic_play_arrow_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavorite"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_200"
                    android:contentDescription="@string/action_add_favorite"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_favorite_24"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWatchlist"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_200"
                    android:contentDescription="@string/action_add_watchlist"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_playlist_add"
                    app:iconPadding="0dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrailer"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_100"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/action_trailer"
                android:visibility="gone"
                app:icon="@drawable/ic_movie_24" />

            <!-- ═══ Synopsis ═══ -->
            <TextView
                android:id="@+id/overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_300"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:textAppearance="@style/TextAppearance.Nashat.Body.Medium"
                android:textColor="@color/content_secondary" />

            <!-- ═══ Episodes (series only) ═══ -->
            <LinearLayout
                android:id="@+id/episodesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/screen_gutter">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/details_episodes"
                        android:textAppearance="@style/TextAppearance.Nashat.Title.Medium"
                        android:textColor="@color/content_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeason"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        app:icon="@drawable/ic_chevron_right_24"
                        app:iconGravity="end" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/episodesLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="@dimen/space_600"
                    android:indeterminateTint="@color/accent_text"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_200"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="@dimen/screen_gutter" />
            </LinearLayout>

            <!-- ═══ Cast ═══ -->
            <LinearLayout
                android:id="@+id/castSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/screen_gutter"
                    android:paddingBottom="@dimen/space_200"
                    android:text="@string/details_cast"
                    android:textAppearance="@style/TextAppearance.Nashat.Title.Medium"
                    android:textColor="@color/content_primary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/castList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/screen_gutter"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ═══ Recommendations ═══ -->
            <LinearLayout
                android:id="@+id/recommendationsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/screen_gutter"
                    android:paddingBottom="@dimen/space_200"
                    android:text="@string/details_also_like"
                    android:textAppearance="@style/TextAppearance.Nashat.Title.Medium"
                    android:textColor="@color/content_primary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommendationsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/screen_gutter"
                    android:scrollbars="none" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══ Loading / error ═══ -->
    <ProgressBar
        android:id="@+id/detailsLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_text" />

    <LinearLayout
        android:id="@+id/detailsError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_base"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_600"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/details_load_failed_title"
            android:textAppearance="@style/TextAppearance.Nashat.Title.Medium"
            android:textColor="@color/content_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_200"
            android:gravity="center"
            android:text="@string/details_load_failed_body"
            android:textAppearance="@style/TextAppearance.Nashat.Body.Medium"
            android:textColor="@color/content_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_400"
            android:text="@string/action_retry" />
    </LinearLayout>

</FrameLayout>

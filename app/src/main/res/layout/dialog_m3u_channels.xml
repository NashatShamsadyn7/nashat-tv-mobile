<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main_gradient"
    android:minHeight="400dp">

    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textColor="@color/accent_primary"
        android:textSize="@dimen/type_size_title_medium"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editSearchChannel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:hint="Search channels..."
        android:background="@drawable/overlay_pill_bg"
        android:padding="12dp"
        android:elevation="4dp"
        android:textColor="@color/white"
        android:textColorHint="@color/home_text_tertiary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDialogChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  "Your week": total watch time as the headline number, two supporting
  figures, and minutes per weekday as bars with today highlighted. Shared by
  Home and the profile page; WeekCard.bind() fills it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_soft"
    android:orientation="vertical"
    android:padding="@dimen/space_500">

    <TextView
        android:id="@+id/weekEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stats_your_week"
        android:textAppearance="@style/TextAppearance.Nashat.Eyebrow" />

    <TextView
        android:id="@+id/weekTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_100"
        android:textAppearance="@style/TextAppearance.Nashat.Stat.Large" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stats_watch_time"
        android:textAppearance="@style/TextAppearance.Nashat.Label.Medium"
        android:textColor="@color/content_tertiary" />

    <com.nashat.tv.ui.chart.BarChart
        android:id="@+id/weekBars"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="@dimen/space_400" />

    <TextView
        android:id="@+id/weekEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_200"
        android:text="@string/stats_empty"
        android:textAppearance="@style/TextAppearance.Nashat.Body.Small"
        android:textColor="@color/content_secondary"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/edge_width"
        android:layout_marginVertical="@dimen/space_400"
        android:background="@color/edge" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weekSessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Nashat.Stat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_sessions"
                android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                android:textColor="@color/content_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weekAverage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Nashat.Stat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_daily_avg"
                android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                android:textColor="@color/content_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weekTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Nashat.Stat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_top_category"
                android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                android:textColor="@color/content_tertiary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

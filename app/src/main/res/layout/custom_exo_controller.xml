<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════
   PLAYER CONTROLS
  ══════════════════════════════════════════════════════════════════════

   Rebuilt around one rule: controls sit ON someone's content, so every
   pixel of chrome has to earn its place.

   What changed:

   · THE PLAY BUTTON SHRANK AND WENT TRANSPARENT. It was a 72dp disc filled
     with solid brand colour, parked in the exact centre of the frame — over
     the newsreader's face on every channel. It is now 64dp of translucent
     black with a white glyph: unmistakably a button, and you can still see
     through it to the picture.

   · REWIND / FORWARD ARE WHITE AND 48dp. They were grey-tinted at 56dp with
     no background, which on bright footage disappeared completely.

   · LIVE STREAMS NO LONGER SHOW A SEEK BAR. A live channel has no duration,
     so the old bar rendered nonsense like "01:00 / 00:31" and offered a
     scrubber that could not go anywhere. PlayerActivity now switches between
     `live_indicator` and `vod_controls`, so a channel shows a LIVE badge and
     a film shows a real timeline.

   · PLAYBACK SPEED IS GONE FROM THE LIVE BAR for the same reason: 1.5x on a
     live broadcast has no meaning. It lives in the settings sheet, where it
     applies to on-demand playback.

   · The whole chrome uses one scrim gradient top and bottom rather than a
     coloured bar, so it reads as a shadow over the video instead of a panel
     bolted on top of it.

   ORDER MATTERS: gesture layers must stay first so the control bars are
   drawn above them and win the touch events.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <!-- ══ GESTURE LAYERS (behind the controls) ═════════════════════
         Left half = brightness, right half = volume. -->
    <LinearLayout
        android:id="@+id/gesture_areas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="fill"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false"
        android:orientation="horizontal"
        android:weightSum="2">

        <FrameLayout
            android:id="@+id/gesture_area_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/gesture_area_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="false"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- ══ TOP BAR ══════════════════════════════════════════════════
         Back on the leading edge with the title beside it — the pairing
         users read as "this is what you are watching, and here is the way
         out". Everything else is a secondary action on the trailing edge. -->
    <LinearLayout
        android:id="@+id/exo_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_top_gradient"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_200"
        android:paddingTop="@dimen/space_200"
        android:paddingEnd="@dimen/space_200"
        android:paddingBottom="@dimen/space_400">

        <ImageButton
            android:id="@+id/exo_back"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/exo_channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_200"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Nashat.Title.Medium"
            android:textColor="@android:color/white"
            tools:text="Rudaw TV" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/exo_cast"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:mediaRouteTypes="user"
            android:visibility="gone"
            app:mediaRouteButtonTint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_pip"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_pip"
            android:src="@drawable/ic_pip_24"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_fullscreen"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_fullscreen"
            android:src="@drawable/ic_fullscreen_24"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_settings"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_settings"
            android:src="@drawable/ic_settings_24"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- ══ CENTRE TRANSPORT ═════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginEnd="@dimen/space_800"
            android:background="@drawable/bg_player_button"
            android:contentDescription="@string/player_rewind"
            android:scaleType="centerInside"
            android:src="@drawable/ic_fast_rewind_24"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@id/exo_play"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_player_button_primary"
            android:contentDescription="@string/player_play"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow_24"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@id/exo_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_player_button_primary"
            android:contentDescription="@string/player_pause"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pause_24"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_800"
            android:background="@drawable/bg_player_button"
            android:contentDescription="@string/player_forward"
            android:scaleType="centerInside"
            android:src="@drawable/ic_fast_forward_24"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- ══ BOTTOM BAR ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_bottom_gradient"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_300"
        android:paddingTop="@dimen/space_400"
        android:paddingEnd="@dimen/space_300"
        android:paddingBottom="@dimen/space_300">

        <!-- LIVE: a badge, not a timeline. Shown for channels; PlayerActivity
             hides this and reveals vod_controls for films and episodes. -->
        <LinearLayout
            android:id="@+id/live_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_200"
            android:background="@drawable/live_badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_300"
            android:paddingTop="@dimen/space_100"
            android:paddingEnd="@dimen/space_300"
            android:paddingBottom="@dimen/space_100">

            <View
                android:layout_width="@dimen/space_200"
                android:layout_height="@dimen/space_200"
                android:background="@drawable/live_dot_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_200"
                android:text="@string/badge_live"
                android:textAppearance="@style/TextAppearance.Nashat.Badge.Live"
                android:textColor="@color/on_status_live_fill" />
        </LinearLayout>

        <!-- ON DEMAND: the real timeline. Hidden while a channel plays. -->
        <LinearLayout
            android:id="@+id/vod_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_100"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="48dp"
                android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                android:textColor="@android:color/white"
                tools:text="12:04" />

            <com.google.android.exoplayer2.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_200"
                android:layout_marginEnd="@dimen/space_200"
                android:layout_weight="1"
                app:bar_height="3dp"
                app:buffered_color="#4DFFFFFF"
                app:played_color="@color/accent_fill"
                app:scrubber_color="@color/accent_fill"
                app:scrubber_dragged_size="18dp"
                app:scrubber_enabled_size="12dp"
                app:unplayed_color="#33FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="48dp"
                android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                android:textColor="#B3FFFFFF"
                tools:text="1:47:20" />
        </LinearLayout>

        <!-- Secondary actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/exo_volume"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/acc_volume"
                android:src="@drawable/ic_volume_up_24"
                app:tint="@android:color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_weight="1" />

            <!-- Speed. Only meaningful on demand, so PlayerActivity hides it
                 alongside the timeline when a live channel is playing. -->
            <TextView
                android:id="@+id/exo_playback_speed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/speed_badge_bg"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="@dimen/space_300"
                android:paddingEnd="@dimen/space_300"
                android:textAppearance="@style/TextAppearance.Nashat.Label.Medium"
                android:textColor="@android:color/white"
                android:visibility="gone"
                tools:text="1.0x"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/exo_subtitle"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_100"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/acc_subtitles"
                android:src="@drawable/ic_subtitles_24"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/exo_audio_track"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/acc_audio_track"
                android:src="@drawable/ic_audiotrack_24"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@id/exo_buffering"
        style="@style/Widget.Nashat.Progress.Circular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true" />

    <!-- ══ GESTURE OSD ══════════════════════════════════════════════
         Transient pills shown while a swipe is in progress. -->

    <LinearLayout
        android:id="@+id/overlay_brightness"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="@dimen/space_600"
        android:background="@drawable/overlay_pill_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_300"
        android:visibility="gone">

        <ImageView
            android:id="@+id/brightness_icon"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_brightness_24"
            app:tint="@android:color/white" />

        <ProgressBar
            android:id="@+id/brightness_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/space_300"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/accent_fill" />

        <TextView
            android:id="@+id/brightness_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_200"
            android:textAppearance="@style/TextAppearance.Nashat.Label.Medium"
            android:textColor="@android:color/white"
            tools:text="50%" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay_volume"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="@dimen/space_600"
        android:background="@drawable/overlay_pill_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_300"
        android:visibility="gone">

        <ImageView
            android:id="@+id/volume_icon"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume_up_24"
            app:tint="@android:color/white" />

        <ProgressBar
            android:id="@+id/volume_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/space_300"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/accent_fill" />

        <TextView
            android:id="@+id/volume_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_200"
            android:textAppearance="@style/TextAppearance.Nashat.Label.Medium"
            android:textColor="@android:color/white"
            tools:text="50%" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay_seek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/overlay_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_400"
        android:paddingTop="@dimen/space_300"
        android:paddingEnd="@dimen/space_400"
        android:paddingBottom="@dimen/space_300"
        android:visibility="gone">

        <ImageView
            android:id="@+id/seek_direction_icon"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fast_forward_24"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/seek_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_200"
            android:textAppearance="@style/TextAppearance.Nashat.Title.Small"
            android:textColor="@android:color/white"
            tools:text="+10s" />
    </LinearLayout>

    <!-- Gesture hints. Shown once on first launch, then never again — the
         old version hard-coded four lines of untranslatable English into the
         layout and showed them as a permanent overlay. -->
    <LinearLayout
        android:id="@+id/overlay_hints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:background="@drawable/overlay_pill_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_300"
        android:visibility="gone">

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/player_gesture_hints"
            android:textAppearance="@style/TextAppearance.Nashat.Body.Small"
            android:textColor="@android:color/white" />
    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Enhanced ExoPlayer custom controller:
  - Keep all existing controls and IDs for compatibility
  - Add gesture zones:
      * Left half (gesture_area_left): vertical swipe for brightness
      * Right half (gesture_area_right): vertical swipe for volume
      * Horizontal swipe (either half): seek preview overlay
  - Add smooth on-screen overlays (brightness/volume/seek) with subtle backgrounds
  - Make paddings compact while keeping TV usability
  - All overlays default to GONE; show/hide from PlayerActivity logic
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <!-- Top controls bar (compact) -->
    <LinearLayout
        android:id="@+id/exo_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/exo_controls_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/exo_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_24"
            android:contentDescription="@string/cd_back_button"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/exo_channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/exo_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_24"
            android:contentDescription="@string/acc_settings"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_pip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pip_24"
            android:contentDescription="@string/acc_pip"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_fullscreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_fullscreen_24"
            android:contentDescription="@string/player_fullscreen"
            android:tint="@android:color/white" />
    </LinearLayout>

    <!-- Center play controls (compact) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/exo_controls_background"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_fast_rewind_24"
            android:contentDescription="@string/acc_rewind"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@id/exo_play"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/exo_play_button_background"
            android:src="@drawable/ic_play_arrow_24"
            android:contentDescription="@string/acc_play"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@id/exo_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/exo_play_button_background"
            android:src="@drawable/ic_pause_24"
            android:contentDescription="@string/acc_pause"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_fast_forward_24"
            android:contentDescription="@string/acc_fast_forward"
            android:tint="@android:color/white" />
    </LinearLayout>

    <!-- Bottom controls bar (compact) -->
    <LinearLayout
        android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/exo_controls_background"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <!-- Progress bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:minWidth="40dp"
                android:gravity="center" />

            <com.google.android.exoplayer2.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:played_color="@color/gentle_gold"
                app:buffered_color="#80FFFFFF"
                app:unplayed_color="#40FFFFFF"
                app:scrubber_color="@color/gentle_gold" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:minWidth="40dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Additional controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/exo_audio_track"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_audiotrack_24"
                android:contentDescription="@string/acc_audio_track"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/exo_subtitle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_subtitles_24"
                android:contentDescription="@string/acc_subtitles"
                android:tint="@android:color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/exo_playback_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1x"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:minWidth="32dp"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/exo_volume"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_volume_up_24"
                android:contentDescription="@string/acc_volume"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@id/exo_buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/emerald_green" />

    <!-- ===================== New Gesture Layers & OSD Overlays ===================== -->

    <!-- Fullscreen gesture capture zones: left = brightness, right = volume -->
    <LinearLayout
        android:id="@+id/gesture_areas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="2"
        android:clickable="true"
        android:focusable="false"
        android:background="@android:color/transparent"
        android:layout_gravity="fill">

        <!-- Left half: Brightness (vertical swipe) -->
        <FrameLayout
            android:id="@+id/gesture_area_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/quality"
            android:importantForAccessibility="no" />

        <!-- Right half: Volume (vertical swipe) -->
        <FrameLayout
            android:id="@+id/gesture_area_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/acc_volume"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Brightness overlay (shows while adjusting) -->
    <LinearLayout
        android:id="@+id/overlay_brightness"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="20dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/exo_controls_background"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/brightness_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <ProgressBar
            android:id="@+id/brightness_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="50"
            android:max="100"
            android:progressTint="@color/gentle_gold"
            android:indeterminate="false" />

        <TextView
            android:id="@+id/brightness_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="50%"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Volume overlay (shows while adjusting) -->
    <LinearLayout
        android:id="@+id/overlay_volume"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/exo_controls_background"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/volume_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:tint="@android:color/white"
            android:src="@drawable/ic_volume_up_24"
            android:contentDescription="@string/acc_volume" />

        <ProgressBar
            android:id="@+id/volume_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="50"
            android:max="100"
            android:progressTint="@color/gentle_gold"
            android:indeterminate="false" />

        <TextView
            android:id="@+id/volume_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="50%"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Seek overlay (shows +/- seconds with icon) -->
    <LinearLayout
        android:id="@+id/overlay_seek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/exo_controls_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/seek_direction_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:tint="@android:color/white"
            android:src="@drawable/ic_fast_forward_24"
            android:contentDescription="@string/acc_fast_forward" />

        <TextView
            android:id="@+id/seek_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="+10s"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Mini hint overlay (optional, can be toggled once to educate users) -->
    <LinearLayout
        android:id="@+id/overlay_hints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/exo_controls_background"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Left: Brightness (Swipe Up/Down)\nRight: Volume (Swipe Up/Down)\nDouble-Tap: Seek\nHorizontal Swipe: Seek"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>
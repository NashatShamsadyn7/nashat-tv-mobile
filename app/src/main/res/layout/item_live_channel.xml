<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel tile: the broadcaster's logo on a light plate (logos are drawn for a
  white page), then the name and a category line whose dot carries the
  category colour used in the Live TV chart.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_100"
    android:background="@drawable/bg_card_soft"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_press_soft"
    android:orientation="vertical"
    android:padding="@dimen/space_150">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_logo_plate">

        <com.nashat.tv.ui.AspectImageView
            android:id="@+id/ivChannelLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_channel_logo"
            android:padding="@dimen/space_200"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/liveIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_100"
            android:background="@drawable/bg_live_badge"
            android:paddingHorizontal="@dimen/space_150"
            android:paddingVertical="1dp"
            android:text="@string/badge_live"
            android:textAppearance="@style/TextAppearance.Nashat.Badge.Live"
            android:textColor="@color/on_status_live_fill"
            android:textSize="9sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_150"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Nashat.Label.Large"
        android:textColor="@color/content_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/liveDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/tvChannelCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_100"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
            android:textColor="@color/content_tertiary" />
    </LinearLayout>

</LinearLayout>

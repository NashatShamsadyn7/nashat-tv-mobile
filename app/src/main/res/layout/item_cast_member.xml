<?xml version="1.0" encoding="utf-8"?>
<!-- One cast member: round portrait, actor name, character name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_200">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profile"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@color/surface_sunken"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/ShapeAppearance.Nashat.Circle" />

    <TextView
        android:id="@+id/actorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_150"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
        android:textColor="@color/content_primary" />

    <TextView
        android:id="@+id/characterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
        android:textColor="@color/content_tertiary" />

</LinearLayout>

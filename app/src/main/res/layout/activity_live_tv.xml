<?xml version="1.0" encoding="utf-8"?>
<!--
  LIVE TV

  The bar (title, search) slides away as the grid scrolls and comes back on
  the first upward flick; the category chips stay pinned under it. The first
  item of the grid is a stats card — how many channels, split by category as
  a bar and legend — built by LiveTvActivity.HeaderAdapter.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:fitsSystemWindows="true"
    tools:context=".LiveTvActivity">

  <!-- Everything the glass nav floats over. Must stay a SIBLING of the bar,
       never its parent — see BottomNav.bindBackdrop. -->
  <androidx.coordinatorlayout.widget.CoordinatorLayout
      android:id="@+id/contentBehindNav"
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <!-- ══ APP BAR ══════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_base"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_300"
            android:paddingEnd="@dimen/screen_gutter"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <!-- Wordmark + count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:contentDescription="@string/cd_app_logo"
                    android:src="@drawable/nashat_logo"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_live_tv"
                        android:textAppearance="@style/TextAppearance.Nashat.Section"
                        android:textSize="24sp" />

                    <!-- Region focus. Populated by updateSubtitle(). -->
                    <TextView
                        android:id="@+id/tvScreenSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Nashat.Body.Small"
                        tools:text="Showing Iraq first" />
                </LinearLayout>

                <!-- Channel count. Plain text, tertiary: it is a fact about
                     the list, not an action or a status. -->
                <TextView
                    android:id="@+id/tvChannelCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_200"
                    android:textAppearance="@style/TextAppearance.Nashat.Label.Medium"
                    android:textColor="@color/content_tertiary"
                    tools:text="38 channels" />
            </LinearLayout>

            <!-- Search -->
            <EditText
                android:id="@+id/editSearch"
                style="@style/Widget.Nashat.SearchField"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_300"
                android:autofillHints=""
                android:drawableStart="@drawable/ic_search_24"
                android:drawableTint="@color/content_tertiary"
                android:hint="@string/live_search_hint"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- ══ CATEGORY FILTER ══════════════════════════════════════
             Populated by rebuildCategoryChips(). Visible — the old file
             hid this row entirely. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_300"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_200"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══ CONTENT ══════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_300"
                android:paddingTop="@dimen/space_100"
                android:paddingEnd="@dimen/space_300"
                android:paddingBottom="@dimen/bottom_nav_height"
                android:scrollbars="none"
                tools:itemCount="12"
                tools:listitem="@layout/item_live_channel" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Empty / error state. Title, explanation, and one recovery
             action — the old version had an icon and a bare error line. -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_800"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tv_series"
                app:tint="@color/content_tertiary" />

            <TextView
                android:id="@+id/tvEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_400"
                android:gravity="center"
                android:text="@string/state_empty_channels_title"
                android:textAppearance="@style/TextAppearance.Nashat.Title.Medium"
                android:textColor="@color/content_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_200"
                android:gravity="center"
                android:text="@string/state_empty_channels_body"
                android:textAppearance="@style/TextAppearance.Nashat.Body.Medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Nashat.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_600"
                android:text="@string/action_retry" />
        </LinearLayout>

        <!-- Loading skeleton. Twelve placeholder tiles laid out on the same
             grid as the real content, so the list does not jump when it
             arrives. -->
        <LinearLayout
            android:id="@+id/skeletonView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/space_300"
            android:visibility="gone"
            tools:visibility="gone">

            <include layout="@layout/item_skeleton_row" />
            <include layout="@layout/item_skeleton_row" />
            <include layout="@layout/item_skeleton_row" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            style="@style/Widget.Nashat.Progress.Circular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
  </androidx.coordinatorlayout.widget.CoordinatorLayout>

  <!-- ══ BOTTOM NAVIGATION ════════════════════════════════════════
       The shared bar. BottomNav.bind() fills it, marks LIVE as the active
       tab and points its blur at contentBehindNav. -->
  <include layout="@layout/view_bottom_nav" />

</FrameLayout>

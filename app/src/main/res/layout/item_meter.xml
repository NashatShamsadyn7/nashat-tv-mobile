<?xml version="1.0" encoding="utf-8"?>
<!-- A labelled horizontal meter: label and value on one line, bar beneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_300">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meterLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Nashat.Label.Medium"
            android:textColor="@color/content_secondary" />

        <TextView
            android:id="@+id/meterValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Nashat.Label.Large"
            android:textColor="@color/content_primary" />
    </LinearLayout>

    <com.nashat.tv.ui.chart.MeterBar
        android:id="@+id/meterBar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="@dimen/space_150" />
</LinearLayout>

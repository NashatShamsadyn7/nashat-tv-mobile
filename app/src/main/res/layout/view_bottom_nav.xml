<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's bottom navigation, in one file.

    Each screen previously carried its own hand-written copy of this bar, which
    is why the four copies had drifted apart — different icon sizes, different
    label colours, and one of them missing a touch target. Every screen now
    includes this and calls BottomNav.bind() to fill and mark it.

    The bar is a GLASS layer: it floats over the content rather than sitting
    below it, and the host screen pads its scrolling content by
    bottom_nav_height so nothing is permanently hidden underneath. That is
    what the blur is for — the user keeps the sense that the list continues
    past the bar instead of ending at it.

    The four tabs are no longer written out here. The container starts empty
    and BottomNav inflates item_bottom_nav.xml once per destination; see that
    file for why.
-->
<com.nashat.tv.ui.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_glass_panel">

    <LinearLayout
        android:id="@+id/bottomNavItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false" />

</com.nashat.tv.ui.GlassView>

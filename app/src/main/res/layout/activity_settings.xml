<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings.

    Two structural fixes beyond the restyle:

    · THE NAV BAR IS HERE NOW. The bar has a Settings tab, and tapping it
      landed the user on a screen with no bar — the only way back was the
      system Back button or the toolbar arrow. A destination reachable from
      the tab bar has to keep the tab bar.

    · THE CARDS HAVE A SURFACE. Each group declared
      cardBackgroundColor="@color/transparent" and then set
      android:background="@drawable/bg_glass_card" — which MaterialCardView
      ignores, because it manages its own background drawable. So the
      "glass" never rendered and the groups were outlines around nothing.
      They are opaque surfaces with a 2dp edge now, like every other card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:fitsSystemWindows="true"
    tools:context=".SettingsActivity">

  <LinearLayout
      android:id="@+id/contentBehindNav"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Nashat.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="0dp"
        app:title="@string/profile_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ═══════ PROFILE DASHBOARD ═══════
                 The viewer's own numbers first: the week as a chart, where
                 their time goes by category, and what is in their library.
                 ProfileDashboard.bind() fills it on every resume. -->
            <include
                android:id="@+id/profileWeek"
                layout="@layout/view_week_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/splitCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_400"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="@dimen/space_500"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_split"
                    android:textAppearance="@style/TextAppearance.Nashat.Eyebrow" />

                <com.nashat.tv.ui.chart.SegmentBar
                    android:id="@+id/splitBar"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="@dimen/space_300" />

                <LinearLayout
                    android:id="@+id/splitLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_300"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_400"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="@dimen/space_500">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_library"
                    android:textAppearance="@style/TextAppearance.Nashat.Eyebrow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_200"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/libFavorites"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Nashat.Stat" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/row_favorites"
                            android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                            android:textColor="@color/content_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/libWatchlist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Nashat.Stat" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/row_watchlist"
                            android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                            android:textColor="@color/content_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/libContinue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Nashat.Stat" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/row_continue"
                            android:textAppearance="@style/TextAppearance.Nashat.Label.Small"
                            android:textColor="@color/content_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_800"
                android:layout_marginBottom="@dimen/space_300"
                android:text="@string/profile_settings"
                android:textAppearance="@style/TextAppearance.Nashat.Section" />

            <!-- ═══════ PLAYBACK ═══════ -->
            <TextView
                style="@style/TextAppearance.Nashat.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_playback"
                android:textColor="@color/content_tertiary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:strokeWidth="@dimen/edge_width"
                app:strokeColor="@color/edge"
                app:cardBackgroundColor="@color/surface_raised"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        style="@style/Widget.Nashat.Switch"
                        android:id="@+id/switchAutoPlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/auto_play_videos"
                        android:textColor="@color/text_primary"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        style="@style/Widget.Nashat.Switch"
                        android:id="@+id/switchHDQuality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/prefer_hd_quality"
                        android:textColor="@color/text_primary"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        style="@style/Widget.Nashat.Switch"
                        android:id="@+id/switchDataSaver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/data_saver"
                        android:textColor="@color/text_primary"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        style="@style/Widget.Nashat.Switch"
                        android:id="@+id/switchBackgroundPlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/background_play"
                        android:textColor="@color/text_primary"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <LinearLayout
                        android:id="@+id/buffer_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_settings_24"
                            app:tint="@color/content_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buffer_size"
                                android:textColor="@color/text_primary"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/tvBufferValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buffer_medium"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/type_size_body_small" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <LinearLayout
                        android:id="@+id/refresh_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_settings_24"
                            app:tint="@color/content_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/refresh_frequency"
                                android:textColor="@color/text_primary"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/tvRefreshValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/refresh_weekly"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/type_size_body_small" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ APPEARANCE ═══════ -->
            <TextView
                style="@style/TextAppearance.Nashat.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:text="@string/appearance"
                android:textColor="@color/content_tertiary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:strokeWidth="@dimen/edge_width"
                app:strokeColor="@color/edge"
                app:cardBackgroundColor="@color/surface_raised"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Dark Mode Toggle -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        style="@style/Widget.Nashat.Switch"
                        android:id="@+id/switchDarkMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/dark_mode"
                        android:textColor="@color/text_primary"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <!-- Theme -->
                    <LinearLayout
                        android:id="@+id/theme_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_settings_24"
                            app:tint="@color/content_secondary"
                            android:layout_marginEnd="16dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/theme"
                                android:textColor="@color/text_primary"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/theme_desc"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/type_size_body_small" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <!-- Language -->
                    <LinearLayout
                        android:id="@+id/language_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_about_24"
                            app:tint="@color/content_secondary"
                            android:layout_marginEnd="16dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/language"
                                android:textColor="@color/text_primary"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/tvCurrentLang"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="English"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/type_size_body_small" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ MY CONTENT ═══════ -->
            <TextView
                style="@style/TextAppearance.Nashat.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_my_content"
                android:textColor="@color/content_tertiary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:strokeWidth="@dimen/edge_width"
                app:strokeColor="@color/edge"
                app:cardBackgroundColor="@color/surface_raised"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Watch Statistics -->
                    <LinearLayout
                        android:id="@+id/stats_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:layout_marginEnd="@dimen/space_400"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_stats_24"
                            app:tint="@color/content_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_title"
                                android:textColor="@color/text_primary"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/tvStatsPreview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_subtitle"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/type_size_body_small" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <!-- Custom Playlists -->
                    <LinearLayout
                        android:id="@+id/playlists_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:layout_marginEnd="@dimen/space_400"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_list_24"
                            app:tint="@color/content_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlists_title"
                                android:textColor="@color/text_primary"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/tvPlaylistsPreview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlists_subtitle"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/type_size_body_small" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ STORAGE ═══════ -->
            <TextView
                style="@style/TextAppearance.Nashat.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_storage"
                android:textColor="@color/content_tertiary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:strokeWidth="@dimen/edge_width"
                app:strokeColor="@color/edge"
                app:cardBackgroundColor="@color/surface_raised"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/clear_cache_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_settings_24"
                            app:tint="@color/accent_secondary"
                            android:layout_marginEnd="16dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/clear_cache"
                                android:textColor="@color/text_primary"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/tvCacheSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/clear_cache_desc"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/type_size_body_small" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════ SUPPORT ═══════ -->
            <TextView
                style="@style/TextAppearance.Nashat.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:text="@string/section_support"
                android:textColor="@color/content_tertiary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:strokeWidth="@dimen/edge_width"
                app:strokeColor="@color/edge"
                app:cardBackgroundColor="@color/surface_raised"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- About -->
                    <LinearLayout
                        android:id="@+id/about_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_about_24"
                            app:tint="@color/content_secondary"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/menu_about"
                            android:textColor="@color/text_primary"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <!-- Contact Us -->
                    <LinearLayout
                        android:id="@+id/contact_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_contact_24"
                            app:tint="@color/content_secondary"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/contact_us"
                            android:textColor="@color/text_primary"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <!-- Rate App -->
                    <LinearLayout
                        android:id="@+id/rate_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_rate_24"
                            app:tint="@color/content_secondary"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rate_app"
                            android:textColor="@color/text_primary"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/edge_inset" />

                    <!-- Share App -->
                    <LinearLayout
                        android:id="@+id/share_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_home_24"
                            app:tint="@color/content_secondary"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/share_app"
                            android:textColor="@color/text_primary"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- App Info Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="32dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/accent_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/type_size_body_medium" />

                <TextView
                    android:id="@+id/tvVersionInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="v1.0"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/type_size_label_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/developer_name"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/type_size_label_medium" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
  </LinearLayout>

  <include layout="@layout/view_bottom_nav" />

</FrameLayout>

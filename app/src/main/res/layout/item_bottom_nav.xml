<?xml version="1.0" encoding="utf-8"?>
<!-- One bottom-nav destination: icon in a pill (tinted when active) over a
     label. BottomNav inflates one per tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navItem"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_nav_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_50">

    <FrameLayout
        android:id="@+id/navItemPill"
        android:layout_width="56dp"
        android:layout_height="30dp">

        <ImageView
            android:id="@+id/navItemIcon"
            android:layout_width="@dimen/bottom_nav_icon_size"
            android:layout_height="@dimen/bottom_nav_icon_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/navItemLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Nashat.Label.Small" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is disabled in the manifest (allowBackup="false").
     These rules act as defense-in-depth in case it gets re-enabled. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>

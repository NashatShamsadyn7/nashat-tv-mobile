<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════
   TABLET OVERRIDES (sw600dp)
  ══════════════════════════════════════════════════════════════════════

   Only the deltas from values/dimens.xml.

   A tablet is held at roughly phone distance, so type barely moves — a
   couple of points on the largest roles, nothing on body text. Blowing up
   body copy here is the classic mistake that makes a tablet layout look
   like a phone screenshot stretched to fit.

   What actually changes is DENSITY: the extra width is spent on more items
   per row and a wider gutter, not on bigger items. Cards grow only enough
   to keep their proportion against the larger gutter.
-->
<resources>

    <!-- Type: only the display and headline roles gain weight, because a
         hero title has proportionally more room to fill. Body stays put. -->
    <dimen name="type_size_display">40sp</dimen>
    <dimen name="type_size_headline">28sp</dimen>
    <dimen name="type_size_title_large">22sp</dimen>
    <dimen name="type_size_title_medium">18sp</dimen>

    <!-- Space: a wider gutter keeps line length readable. Text lines longer
         than ~75 characters are measurably harder to track back from. -->
    <dimen name="screen_gutter">24dp</dimen>
    <dimen name="row_gap">32dp</dimen>
    <dimen name="card_gap">16dp</dimen>

    <!-- Components: modest growth. The width goes to more columns. -->
    <dimen name="poster_width">150dp</dimen>
    <dimen name="poster_height">225dp</dimen>
    <dimen name="backdrop_width">272dp</dimen>
    <dimen name="backdrop_height">153dp</dimen>
    <dimen name="channel_tile_size">120dp</dimen>
    <dimen name="channel_logo_size">76dp</dimen>
    <dimen name="avatar_size">88dp</dimen>

    <dimen name="hero_height">520dp</dimen>
    <dimen name="hero_scrim_height">240dp</dimen>

    <!-- ══ LEGACY BRIDGE ════════════════════════════════════════════ -->
    <dimen name="activity_horizontal_margin">24dp</dimen>
    <dimen name="activity_vertical_margin">24dp</dimen>
    <dimen name="channel_card_width">150dp</dimen>
    <dimen name="channel_card_height">225dp</dimen>
    <dimen name="channel_item_height">120dp</dimen>
    <dimen name="recommended_card_width">150dp</dimen>
    <dimen name="recommended_card_height">225dp</dimen>
    <dimen name="recommended_row_height">255dp</dimen>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════
   NASHAT TV — COLOR SYSTEM · DARK MODE (the default)
  ══════════════════════════════════════════════════════════════════════

   Overrides only the SEMANTIC layer from values/colors.xml, using the
   desktop app's ink scale: #0A0A0B page, #111114 cards, a faint #22222A
   hairline instead of an outline, white text, crimson accent.
-->
<resources>

    <!-- ── Surfaces ─────────────────────────────────────────────── -->
    <color name="surface_base">@color/ink_900</color>       <!-- page background -->
    <color name="surface_raised">@color/ink_800</color>     <!-- cards, sheets -->
    <color name="surface_sunken">#050506</color>     <!-- wells, track fills -->
    <color name="surface_input">@color/ink_700</color>      <!-- search field, chips -->
    <color name="surface_overlay">#F50A0A0B</color>  <!-- 96% base, over media -->
    <color name="surface_inverse">#F4F4F5</color>    <!-- tooltips, snackbars -->

    <!-- Scrims stay black in both modes: they darken artwork, and artwork
         has no mode. A beige scrim would tint every poster. -->
    <color name="scrim_strong">#CC000000</color>
    <color name="scrim_soft">#66000000</color>
    <color name="scrim_none">#00000000</color>

    <!-- ── Borders ──────────────────────────────────────────────────
         `edge` is content_primary here exactly as it is in light mode — the
         same rule, not a dark-mode equivalent of it. That is the whole
         reason a brutalist outline survives the mode switch: the border and
         the text sitting inside it are always the same value, so the
         drawing weight of every card is identical in both modes.

         shadow_block is NOT redefined in this file. It stays brand_lime,
         the same literal in both modes, so a raised element is raised by
         the same amount of the same colour whichever mode you are in. -->
    <color name="edge">@color/ink_600</color>
    <color name="edge_inset">@color/ink_700</color>

    <!-- Glass. Same alphas as light (C7 / EB); only the base hue flips. -->
    <color name="glass_fill">#CC0A0A0B</color>
    <color name="glass_fill_strong">#EB111114</color>
    <color name="glass_fill_opaque">@color/ink_900</color>

    <color name="border_focus">@color/brand_crimson</color>

    <color name="border_hairline">@color/edge_inset</color>
    <color name="border_default">@color/edge</color>
    <color name="border_strong">@color/edge</color>

    <!-- ── Content ──────────────────────────────────────────────── -->
    <color name="content_primary">#FFFFFF</color>    <!-- 17.3:1 on base -->
    <color name="content_secondary">@color/ink_200</color>  <!--  8.8:1 -->
    <color name="content_tertiary">#70707E</color>   <!--  4.6:1 -->
    <color name="content_disabled">@color/ink_400</color>
    <color name="content_inverse">@color/ink_900</color>

    <!-- ── Accent ───────────────────────────────────────────────── -->
    <!-- Unlike light mode, lime IS legible as text here, so accent_text and
         accent_fill converge on the true brand value. -->
    <color name="accent_text">@color/brand_crimson_bright</color>
    <color name="accent_fill">@color/brand_crimson</color>
    <color name="accent_fill_pressed">@color/brand_crimson_deep</color>
    <color name="on_accent_fill">#FFFFFF</color>
    <color name="accent_wash">#26E11D48</color>

    <!-- ── Status ───────────────────────────────────────────────── -->
    <color name="status_live">@color/brand_crimson_bright</color>
    <color name="status_live_fill">@color/brand_crimson</color>
    <color name="on_status_live_fill">#FFFFFF</color>
    <color name="status_success">#34D399</color>
    <color name="status_warning">#FBBF24</color>
    <color name="status_danger">@color/brand_crimson_bright</color>

    <!-- Brighter gold: the light-mode value is muddy against a dark surface. -->
    <color name="rating_star">#FBBF24</color>
    <color name="rating_chip_scrim">#B3000000</color>

    <color name="server_ok">#34D399</color>
    <color name="server_fail">@color/brand_crimson_bright</color>
    <color name="server_checking">@color/content_tertiary</color>

    <!-- ── Focus ────────────────────────────────────────────────── -->
    <color name="focus_ring">@color/brand_crimson</color>
    <color name="focus_surface">#33E11D48</color>


    <!-- ══════════════════════════════════════════════════════════
         LEGACY BRIDGE — literal values only
         (aliases to semantic tokens inherit the above automatically)
         ══════════════════════════════════════════════════════════ -->

    <color name="glass_card_solid">@color/surface_raised</color>
    <color name="glass_card_focused_solid">@color/surface_raised</color>
    <color name="overlay_pill_solid">@color/glass_fill_strong</color>
    <color name="movie_overlay_start">#F20A0A0B</color>
    <color name="movie_overlay_end">#000A0A0B</color>

    <color name="kd_primary_container">#4C0519</color>
    <color name="kd_on_primary_container">#FFE4E6</color>
    <color name="kd_tertiary_container">#4C0519</color>
    <color name="kd_on_tertiary_container">#FFE4E6</color>

    <!-- Logo plate stays light in dark mode. Broadcaster PNGs are baked for
         a white background; inverting the plate would knock out every dark
         logo mark on it. It gains a warm tint instead of pure white so it
         does not glare against #100F0C. -->
    <color name="logo_inner_circle_bg">#F4F4F5</color>
    <color name="logo_gradient_start">#FAFAFA</color>
    <color name="logo_gradient_center">#F4F4F5</color>
    <color name="logo_gradient_end">#E4E4E7</color>

    <!-- Category identity, lightened for dark surfaces. -->
    <color name="category_news">#FB7185</color>
    <color name="category_sports">#34D399</color>
    <color name="category_entertainment">#FBBF24</color>
    <color name="category_kids">#A78BFA</color>
    <color name="category_documentary">#22D3EE</color>
    <color name="category_music">#F472B6</color>
    <color name="category_movies">#60A5FA</color>
    <color name="category_general">#9A9AA8</color>


    <!-- Charts & scores -->
    <color name="chart_track">@color/ink_700</color>
    <color name="chart_bar">@color/ink_500</color>
    <color name="score_high">#34D399</color>
    <color name="score_mid">#FBBF24</color>
    <color name="score_low">@color/brand_crimson_bright</color>
    <color name="rank_numeral">@color/ink_400</color>
    <color name="series_2">#FBBF24</color>
    <color name="series_3">#34D399</color>
    <color name="series_4">#60A5FA</color>
    <color name="series_5">#A78BFA</color>
    <color name="series_6">#F472B6</color>
    <color name="series_7">#2DD4BF</color>
    <!-- Plate behind broadcaster logos. -->
    <color name="logo_plate">#1C1C22</color>
</resources>

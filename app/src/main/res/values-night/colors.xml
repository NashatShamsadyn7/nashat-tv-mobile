<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════
   NASHAT TV — COLOR SYSTEM · DARK MODE
  ══════════════════════════════════════════════════════════════════════

   Overrides only the SEMANTIC layer from values/colors.xml. The brand
   palette is deliberately identical in both modes — lime at #C8F04C clears
   14.6:1 on this background and 5.8:1 as accent_text on the light one, so
   the hero colour never has to shift and the app keeps one identity.

   Every legacy-bridge entry that resolves to a semantic token inherits the
   dark value automatically; only the handful holding literal ARGB (glass,
   scrim overlays, logo plate) is repeated at the bottom.

   The backgrounds are warm near-blacks, not neutral. #100F0C carries a few
   points of red so lime and coral sit at the same temperature as the
   surface; on a neutral #101010 both accents read faintly sour.
-->
<resources>

    <!-- ── Surfaces ─────────────────────────────────────────────── -->
    <color name="surface_base">#100F0C</color>       <!-- page background -->
    <color name="surface_raised">#1A1815</color>     <!-- cards, sheets -->
    <color name="surface_sunken">#0A0907</color>     <!-- wells, track fills -->
    <color name="surface_input">#232019</color>      <!-- search field, chips -->
    <color name="surface_overlay">#F5100F0C</color>  <!-- 96% base, over media -->
    <color name="surface_inverse">#FBF8F1</color>    <!-- tooltips, snackbars -->

    <!-- Scrims stay black in both modes: they darken artwork, and artwork
         has no mode. A beige scrim would tint every poster. -->
    <color name="scrim_strong">#CC000000</color>
    <color name="scrim_soft">#66000000</color>
    <color name="scrim_none">#00000000</color>

    <!-- ── Borders ──────────────────────────────────────────────── -->
    <color name="border_hairline">#26221C</color>
    <color name="border_default">#302B24</color>
    <color name="border_strong">#453E34</color>
    <color name="border_focus">@color/brand_lime</color>

    <!-- ── Content ──────────────────────────────────────────────── -->
    <color name="content_primary">#F7F2E7</color>    <!-- 17.3:1 on base -->
    <color name="content_secondary">#B8AF9D</color>  <!--  8.8:1 -->
    <color name="content_tertiary">#837C6D</color>   <!--  4.6:1 -->
    <color name="content_disabled">#565046</color>
    <color name="content_inverse">#17150F</color>

    <!-- ── Accent ───────────────────────────────────────────────── -->
    <!-- Unlike light mode, lime IS legible as text here, so accent_text and
         accent_fill converge on the true brand value. -->
    <color name="accent_text">@color/brand_lime</color>
    <color name="accent_fill">@color/brand_lime</color>
    <color name="accent_fill_pressed">@color/brand_lime_deep</color>
    <color name="on_accent_fill">@color/brand_ink</color>
    <color name="accent_wash">#29C8F04C</color>

    <!-- ── Status ───────────────────────────────────────────────── -->
    <color name="status_live">@color/brand_coral</color>
    <color name="status_live_fill">@color/brand_coral</color>
    <color name="on_status_live_fill">#2B0A04</color>
    <color name="status_success">#8FD694</color>
    <color name="status_warning">#E8A33D</color>
    <color name="status_danger">@color/brand_coral</color>

    <!-- Brighter gold: the light-mode value is muddy against a dark surface. -->
    <color name="rating_star">#FFC93C</color>
    <color name="rating_chip_scrim">#B3000000</color>

    <color name="server_ok">#8FD694</color>
    <color name="server_fail">@color/brand_coral</color>
    <color name="server_checking">@color/content_tertiary</color>

    <!-- ── Focus ────────────────────────────────────────────────── -->
    <color name="focus_ring">@color/brand_lime</color>
    <color name="focus_surface">#33C8F04C</color>


    <!-- ══════════════════════════════════════════════════════════
         LEGACY BRIDGE — literal values only
         (aliases to semantic tokens inherit the above automatically)
         ══════════════════════════════════════════════════════════ -->

    <color name="glass_card_solid">#14FFFFFF</color>
    <color name="glass_card_focused_solid">#1FFFFFFF</color>
    <color name="overlay_pill_solid">#D9100F0C</color>
    <color name="movie_overlay_start">#F2100F0C</color>
    <color name="movie_overlay_end">#00100F0C</color>

    <color name="kd_primary_container">#33450A</color>
    <color name="kd_on_primary_container">#DFF9A6</color>
    <color name="kd_tertiary_container">#5C1B0E</color>
    <color name="kd_on_tertiary_container">#FFDAD3</color>

    <!-- Logo plate stays light in dark mode. Broadcaster PNGs are baked for
         a white background; inverting the plate would knock out every dark
         logo mark on it. It gains a warm tint instead of pure white so it
         does not glare against #100F0C. -->
    <color name="logo_inner_circle_bg">#EFEADF</color>
    <color name="logo_gradient_start">#F5F1E8</color>
    <color name="logo_gradient_center">#EFEADF</color>
    <color name="logo_gradient_end">#E3DCCD</color>

    <!-- Category identity, lightened for dark surfaces. -->
    <color name="category_news">#FF8E7E</color>
    <color name="category_sports">#C8F04C</color>
    <color name="category_entertainment">#E8A33D</color>
    <color name="category_kids">#C79BF0</color>
    <color name="category_documentary">#5FD4DE</color>
    <color name="category_music">#F587B8</color>
    <color name="category_movies">#93B0EF</color>
    <color name="category_general">#A79B84</color>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary-button fill.

  Focus is listed BEFORE pressed deliberately. On a phone the two states
  never coexist, but on a TV the button under the D-pad is permanently
  focused and only momentarily pressed — putting pressed first would make
  the focused button flash back to its resting colour on every click.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.12" android:color="@color/content_disabled" android:state_enabled="false" />
    <item android:color="@color/brand_lime_bright" android:state_focused="true" />
    <item android:color="@color/accent_fill_pressed" android:state_pressed="true" />
    <item android:color="@color/accent_fill" />
</selector>

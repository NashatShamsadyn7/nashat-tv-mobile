<?xml version="1.0" encoding="utf-8"?>
<!-- Text and icon colour for controls sitting on a normal surface. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="@color/content_disabled" android:state_enabled="false" />
    <item android:color="@color/accent_text" android:state_focused="true" />
    <item android:color="@color/accent_text" android:state_pressed="true" />
    <item android:color="@color/content_primary" />
</selector>

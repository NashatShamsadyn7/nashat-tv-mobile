<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════
   ANDROID TV OVERRIDES — the 10-foot UI
  ══════════════════════════════════════════════════════════════════════

   Only the deltas from values/dimens.xml; everything not named here falls
   back to the phone value. Because type sizes are dimens, overriding them
   here rescales the entire type scale in values/type.xml with no style
   duplicated for TV.

   Three things change on a television and nothing else matters as much:

   1. TEXT GROWS. A phone is read at ~40cm, a TV at ~3m. Body text at 14sp
      is unreadable from a sofa; the scale moves up roughly 1.4x and the
      11sp label floor disappears entirely — nothing here is below 16sp.

   2. THE SAFE AREA APPEARS. Consumer televisions overscan: the outer ~5%
      of the panel can be physically cut off. The 48dp screen gutter is the
      standard TV safe-area inset, and no text or control may sit outside it.

   3. FOCUS BECOMES THE ONLY AFFORDANCE. There is no cursor and no touch —
      the user's entire model of "where am I" is the focus ring, so it is
      thicker here and the tiles are larger so the ring has room to grow
      on focus without colliding with its neighbour.
-->
<resources>

    <!-- ══ TYPE — scaled for a 3-metre viewing distance ═════════════ -->
    <dimen name="type_size_display">48sp</dimen>
    <dimen name="type_size_headline">34sp</dimen>
    <dimen name="type_size_title_large">28sp</dimen>
    <dimen name="type_size_title_medium">24sp</dimen>
    <dimen name="type_size_title_small">20sp</dimen>
    <dimen name="type_size_body_large">22sp</dimen>
    <dimen name="type_size_body_medium">20sp</dimen>
    <dimen name="type_size_body_small">18sp</dimen>
    <dimen name="type_size_label_large">20sp</dimen>
    <dimen name="type_size_label_medium">18sp</dimen>
    <dimen name="type_size_label_small">16sp</dimen>

    <!-- ══ SAFE AREA ════════════════════════════════════════════════
         48dp horizontal / 27dp vertical is the overscan-safe inset. -->
    <dimen name="screen_gutter">48dp</dimen>
    <dimen name="row_gap">40dp</dimen>
    <dimen name="card_gap">20dp</dimen>

    <!-- ══ FOCUS ════════════════════════════════════════════════════ -->
    <dimen name="focus_ring_width">4dp</dimen>
    <dimen name="touch_target_min">56dp</dimen>

    <!-- ══ COMPONENTS ═══════════════════════════════════════════════
         Cards grow so a row still shows 5–6 items on a 1080p panel while
         each remains legible, and so the focus ring has room to scale. -->
    <dimen name="poster_width">180dp</dimen>
    <dimen name="poster_height">270dp</dimen>
    <dimen name="backdrop_width">320dp</dimen>
    <dimen name="backdrop_height">180dp</dimen>
    <dimen name="channel_tile_size">150dp</dimen>
    <dimen name="channel_logo_size">92dp</dimen>
    <dimen name="avatar_size">104dp</dimen>

    <dimen name="hero_height">520dp</dimen>
    <dimen name="hero_scrim_height">260dp</dimen>

    <!-- The bottom bar becomes a top row on TV (a bottom bar is awkward to
         reach with a D-pad), but the height token still governs its band. -->
    <dimen name="bottom_nav_height">80dp</dimen>
    <dimen name="bottom_nav_icon_size">32dp</dimen>
    <dimen name="app_bar_height">72dp</dimen>
    <dimen name="app_bar_icon_button">56dp</dimen>

    <dimen name="search_field_height">64dp</dimen>
    <dimen name="chip_height">52dp</dimen>

    <dimen name="icon_size_sm">20dp</dimen>
    <dimen name="icon_size_md">32dp</dimen>
    <dimen name="icon_size_lg">44dp</dimen>
    <dimen name="icon_size_xl">64dp</dimen>

    <!-- ══ LEGACY BRIDGE ════════════════════════════════════════════ -->
    <dimen name="activity_horizontal_margin">48dp</dimen>
    <dimen name="activity_vertical_margin">27dp</dimen>
    <dimen name="channel_card_width">180dp</dimen>
    <dimen name="channel_card_height">270dp</dimen>
    <dimen name="channel_item_height">150dp</dimen>
    <dimen name="recommended_card_width">180dp</dimen>
    <dimen name="recommended_card_height">270dp</dimen>
    <dimen name="recommended_row_height">300dp</dimen>
    <dimen name="button_height">64dp</dimen>
    <dimen name="search_bar_height">64dp</dimen>

</resources>

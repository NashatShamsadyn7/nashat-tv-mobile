<?xml version="1.0" encoding="utf-8"?>
<!--
    Fades the details backdrop into the page surface.

    The end colour is the page's own surface, so the join disappears in both
    light and dark mode. A fixed black would leave a visible dark band across a
    light-mode screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#00000000"
        android:startColor="@color/surface_base"
        android:type="linear" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Search field background.

  Filled, not outlined. Search sits in the app bar of several screens, and
  an outlined field there adds a second competing rectangle next to the
  screen title. The border only appears once the field is focused, at which
  point it is carrying information rather than decoration.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_sm" />
            <solid android:color="@color/surface_input" />
            <stroke
                android:width="@dimen/stroke_emphasis"
                android:color="@color/focus_ring" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_sm" />
            <solid android:color="@color/surface_input" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/border_default" />
        </shape>
    </item>

</selector>

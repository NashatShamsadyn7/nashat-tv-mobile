<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-nav item. The active tab is marked by its indicator pill and
     accent icon (see item_bottom_nav), not by filling the whole cell, so the
     bar stays quiet and the content above it stays the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/focus_surface" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>

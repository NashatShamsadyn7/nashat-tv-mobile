<?xml version="1.0" encoding="utf-8"?>
<!-- Touch feedback for cards: a rounded ripple, plus a ring when D-pad focused. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_wash">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_md" />
                    <stroke android:width="@dimen/edge_width_focus" android:color="@color/focus_ring" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Dark background for light/white logos -->
    <gradient
        android:startColor="@color/calm_navy"
        android:centerColor="@color/emerald_green_dark"
        android:endColor="@color/calm_navy"
        android:angle="135"
        android:type="linear" />
    
    <!-- Border -->
    <stroke
        android:width="@dimen/edge_width"
        android:color="@color/gentle_gold" />
    
    <!-- Rounded corners -->
    <corners android:radius="@dimen/radius_lg" />
    
</shape>
<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Beautiful gradient background for fallback text -->
    <gradient
        android:startColor="@color/warm_gray_light"
        android:centerColor="@color/creamy_white"
        android:endColor="@color/warm_gray_light"
        android:angle="45"
        android:type="radial"
        android:gradientRadius="40dp" />
    
    <!-- Subtle border -->
    <stroke
        android:width="2dp"
        android:color="@color/emerald_green_light" />
    
</shape>
<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Light background for dark/black logos -->
    <gradient
        android:startColor="@color/creamy_white"
        android:centerColor="@color/warm_gray_light"
        android:endColor="@color/creamy_white"
        android:angle="135"
        android:type="linear" />
    
    <!-- Border -->
    <stroke
        android:width="@dimen/edge_width"
        android:color="@color/emerald_green_light" />
    
    <!-- Rounded corners -->
    <corners android:radius="@dimen/radius_none" />
    
</shape>
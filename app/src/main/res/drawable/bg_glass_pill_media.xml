<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating chip that sits ON VIDEO — gesture HUD, speed badge, the pills in
  the player control bar.

  Fixed dark fill with a white edge in both modes, rather than the themed
  bg_glass_pill. Video has no mode: the player runs Theme.Nashat.Player and
  draws white controls over the picture whatever the system is set to, so a
  themed pill here would come out cream-on-video for every light-mode user.

  This is the one place the "light and dark are identical" rule is satisfied
  by using literal values instead of tokens — because the surface underneath
  is not the app's surface at all.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
    <solid android:color="#C4000000" />
    <stroke
        android:width="@dimen/edge_width"
        android:color="#FFFFFF" />
</shape>

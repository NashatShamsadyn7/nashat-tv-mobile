<?xml version="1.0" encoding="utf-8"?>
<!--
    Watch-progress bar on a Continue Watching card.

    The track is a translucent white rather than a theme surface: it sits on
    artwork, so it has to hold against any picture behind it in either theme.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/accent_fill" />
                <corners android:radius="@dimen/radius_pill" />
            </shape>
        </clip>
    </item>
</layer-list>

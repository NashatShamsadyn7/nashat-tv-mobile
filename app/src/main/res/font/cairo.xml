<?xml version="1.0" encoding="utf-8"?>
<!--
  Cairo — the app's single typeface, the same family Nashat TV Desktop and
  nashat-tv-watch.web.app use, so all three read as one product. It covers
  Latin, Arabic and Kurdish Sorani.

  Static weights are instanced from the variable font (fontTools instancer),
  because fontVariationSettings is API 26+ and this app supports 23. Both
  namespaces are declared on every entry: `android:` from API 26 up, the
  `app:` duplicates for AppCompat on API 23–25.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/cairo_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/cairo_light"
        app:fontStyle="normal"
        app:fontWeight="300" />

    <font
        android:font="@font/cairo_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/cairo_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/cairo_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/cairo_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/cairo_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/cairo_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/cairo_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/cairo_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>

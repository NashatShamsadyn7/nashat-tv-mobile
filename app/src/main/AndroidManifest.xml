<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for network access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".NashatTvApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NashatTV"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="31">

        <!-- Google Cast framework options provider -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.nashat.tv.CastOptionsProvider" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|uiMode" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <activity
            android:name=".MoviesActivity"
            android:exported="false" />

        <activity
            android:name=".SeriesActivity"
            android:exported="false" />

        <!-- One details screen now serves films and series. It replaces
             MovieDetailsActivity and SeriesDetailsActivity, which shared most
             of their code and had drifted apart in the rest. -->
        <activity
            android:name=".DetailsActivity"
            android:exported="false" />

        <!-- Landscape-locked and PiP-capable. configChanges keeps the WebView
             and its playback alive across a rotation or a PiP transition;
             without it the Activity is recreated and the film restarts. -->
        <activity
            android:name=".WebPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ActorDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Firebase list screen (optional entry for realtime DB) -->
        <activity
            android:name=".FirebaseMainActivity"
            android:exported="false" />

        <!-- Redesigned Live TV screen -->
        <activity
            android:name=".LiveTvActivity"
            android:exported="true"
            android:theme="@style/Theme.NashatTV"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false">
        </activity>
    </application>

</manifest>